{
	"schemaVersion": 1,
	"id": "echoaholic",
	"version": "${version}",
	"name": "Echoaholic",
	"description": "Everything you do comes back. Every 5 minutes a ghostly Echo of you joins the world and replays everything you did, for real: it mines, builds and fights.",
	"authors": ["nezo"],
	"contact": {
		"homepage": "https://github.com/nezo32/echoaholic",
		"sources": "https://github.com/nezo32/echoaholic",
		"issues": "https://github.com/nezo32/echoaholic/issues"
	},
	"license": "MIT",
	"icon": "assets/echoaholic/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.echoaholic.Echoaholic"],
		"client": ["dev.echoaholic.client.EchoaholicClient"],
		"modmenu": ["dev.echoaholic.client.ModMenuIntegration"]
	},
	"mixins": [
		"echoaholic.mixins.json",
		{ "config": "echoaholic.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"minecraft": ">=26.2 <26.4-",
		"java": ">=25"
	},
	"suggests": {
		"modmenu": "*"
	}
}
